# ==============================================================================
# Voice RAG System (v3) - .gitignore
# ==============================================================================

# User Specified Exclusions
voice_rag_builder/
Data/
tests/
test/
adiitional_test_notebook/

# Secrets & Environment Configurations
.env
.env.local
.env.*.local
*.env

# Python Bytecode, Caches & Distribution
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
venv/
env/
.venv/
ENV/
env.bak/
venv.bak/

# DeepEval Cache & Evaluation Output Reports
.deepeval/
deepeval_test_results.json
evaluation/reports/*.json
evaluation/reports/*.csv
evaluation/reports/*.html
evaluation/reports/*.md
!evaluation/reports/.gitkeep

# Audio Recordings & Temporary Media
*.wav
*.mp3
*.ogg
*.flac
*.m4a
*.webm

# Notebook Checkpoints & Training Experiments
.ipynb_checkpoints/
adiitional_test_notebook/

# System, Logs & IDE Files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
desktop.ini
*.log
